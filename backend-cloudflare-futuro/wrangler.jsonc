{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gastei",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "..", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "gastei", "database_id": "PREENCHER" }
  ],
  "observability": { "enabled": true }
}
